@prefix : <https://oscarw27.github.io/5294INOR6Y_G1/ontology#> .

# Core ontology prefixes
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

# Metadata & broad entities
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

# Data type and unit prefixes
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .

# For sensor measurements
@prefix sosa:   <http://www.w3.org/ns/sosa/> .

# Physical Activity Ontology
@prefix paco:   <http://purl.bioontology.org/ontology/PACO/> .

<https://oscarw27.github.io/5294INOR6Y_G1/ontology> a owl:Ontology ;
    dcterms:title "Running workout ontology"@en ;
    dcterms:description "A domain ontology modeling running workouts, intensity categories, summary metrics, athlete running patterns derived by k-means clustering, and time-series sensor observations from the Endomondo Heart Rate Prediction V2 dataset. Workout types are aligned with the Physical Activity Ontology (PACO, BioPortal) to support interoperability with clinical physical activity data."@en ;
    owl:versionInfo "1.0"^^xsd:string ;
    rdfs:seeAlso <https://huggingface.co/datasets/rricc22/endomondo-hr-prediction-v2> ;
    owl:imports <http://www.w3.org/ns/sosa/> .

# Based on the raw dataset (no ML), it uses the paco controlled vocabulary for workout intensity
:Athlete a owl:Class ;
    rdfs:subClassOf schema:Person ;
    rdfs:label "Athlete"@en ;
    rdfs:comment "A runner identified by a unique user_id in the Endomondo dataset."@en .

:RunningWorkout a owl:Class ;
    rdfs:subClassOf schema:ExerciseAction ;
    rdfs:label "Running Workout"@en ;
    rdfs:comment "A recorded running session containing aggregate metrics and sequential telemetry points."@en .

:RecoveryRun a owl:Class ;
    rdfs:subClassOf :RunningWorkout ;
    skos:closeMatch paco:Low ;
    rdfs:label "Recovery Run"@en ;
    rdfs:comment "A low-intensity running session categorized as RECOVERY."@en .

:SteadyRun a owl:Class ;
    rdfs:subClassOf :RunningWorkout ;
    skos:closeMatch paco:Moderate ;
    rdfs:label "Steady Run"@en ;
    rdfs:comment "A moderate, consistent-pace running session categorized as STEADY."@en .

:IntensiveRun a owl:Class ;
    rdfs:subClassOf :RunningWorkout ;
    skos:closeMatch paco:Vigorous ;
    rdfs:label "Intensive Run"@en ;
    rdfs:comment "A high-effort running session categorized as INTENSIVE."@en .

# K-means classified workout type is only based on heart rate so this says something about effort
# RunFocus says something about what the person tried to achieve in the run based on many variables (see script)
:RunFocus a owl:Class ;
    rdfs:label "Run Focus"@en ;
    rdfs:comment "The type of a single run as assigned by k-means clustering (k=5) of run shapes: relative heart rate, relative speed, relative distance, number of speed surges, slow-time fraction, heart-rate range and climb per km, all relative to the athlete's own baseline (analysis/run_types in the dataset repository). Values are asserted from the clustering output (analysis/run_types/output/run_labels.csv), not derived from the summary metrics."@en .

:EasyShort a :RunFocus ;
    rdfs:label "Easy / short"@en ;
    rdfs:comment "Short sessions at a slightly relaxed pace relative to the athlete's own average, with few speed surges (7,972 of 39,459 labeled runs)."@en .

:LongSteady a :RunFocus ;
    rdfs:label "Long & steady"@en ;
    rdfs:comment "The longest runs relative to the athlete's own typical distance, at an even pace with few surges (11,861 of 39,459 labeled runs)."@en .

:TempoHard a :RunFocus ;
    rdfs:label "Tempo / hard"@en ;
    rdfs:comment "Sustained hard running: highest relative heart rate (cluster mean 1.09 of the athlete's own baseline) and highest relative speed (1.14) (5,301 of 39,459 labeled runs)."@en .

:FartlekVariable a :RunFocus ;
    rdfs:label "Fartlek / variable"@en ;
    rdfs:comment "Runs with many speed surges (cluster mean 5.7) at otherwise average speed and heart rate, mixing fast and easy stretches (10,412 of 39,459 labeled runs)."@en .

:StopAndGo a :RunFocus ;
    rdfs:label "Stop-and-go"@en ;
    rdfs:comment "Runs with the most surges (cluster mean 8.0), the highest slow-time fraction (0.21) and the lowest relative speed (3,913 of 39,459 labeled runs)."@en .

# Same approach as RunFocus but then generalized over the athlete's entire run history intended for comparison.
:RunningPattern a owl:Class ;
    rdfs:label "Running Pattern"@en ;
    rdfs:comment "An athlete-level running pattern found by k-means clustering of per-athlete aggregates (running frequency, typical distance and pace, speed-per-heartbeat efficiency, relative intensity, within-run speed variation, opening-pace ratio, cardiac drift, climb per km); see analysis/athlete_profiles/output in the dataset repository. A running pattern summarizes an athlete across all their workouts, unlike the workout-type classes above (recorded per session) and the per-run :RunFocus labels, which characterize a single session each."@en .

:EfficientConsistent a :RunningPattern ;
    rdfs:label "Efficient & consistent"@en ;
    rdfs:comment "Athlete with above-average efficiency (typical cluster mean 8.0 km/h per 100 bpm), longer regular runs, low within-run speed variability and mild cardiac drift. Largest pattern (306 of 569 labelled athletes)."@en .

:FastStarterDeveloping a :RunningPattern ;
    rdfs:label "Fast starter / developing"@en ;
    rdfs:comment "Athlete with shorter, slower runs, pronounced heart-rate drift and an opening-pace ratio approaching or exceeding 1 (starts no slower than the rest of the run), at lower aerobic efficiency (216 of 569 labelled athletes)."@en .

:IntervalHeavy a :RunningPattern ;
    rdfs:label "Interval-heavy"@en ;
    rdfs:comment "Athlete whose workouts include a large share of intensive sessions (cluster mean 0.35), at high relative intensity and low efficiency; smallest pattern (47 of 569 labelled athletes). Corresponds to the 'Interval-focused' cluster label in the analysis."@en .

:hasRunningPattern a owl:ObjectProperty ;
    rdfs:domain :Athlete ;
    rdfs:range :RunningPattern ;
    rdfs:label "has running pattern"@en ;
    rdfs:comment "Links an athlete to the running pattern assigned by the k-means clustering. Athletes with fewer than ten recorded runs are left unassigned in the analysis (see analysis/athlete_profiles/output/final_labels.csv)."@en .

# Sensor properties stored in the TelemetryPoint class coming from sosa
:TelemetryPoint a owl:Class ;
    rdfs:subClassOf sosa:ObservationCollection ;
    rdfs:label "Telemetry Point"@en ;
    rdfs:comment "A single timestamped sample in a workout time series grouping heart rate, speed, and altitude readings."@en .

:HeartRate a sosa:ObservableProperty ;
    rdfs:label "Heart Rate"@en ;
    rdfs:comment "Instantaneous heart rate measured in beats per minute (BPM)."@en .

:Speed a sosa:ObservableProperty ;
    rdfs:label "Speed"@en ;
    rdfs:comment "Instantaneous running speed measured in kilometers per hour (km/h)."@en .

:Altitude a sosa:ObservableProperty ;
    rdfs:label "Altitude"@en ;
    rdfs:comment "Elevation above sea level measured in meters (m)."@en .

# Object properties between workouts and athletes/telemetry
:performedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:agent ;
    rdfs:domain :RunningWorkout ;
    rdfs:range :Athlete ;
    rdfs:label "performed by"@en .

:runFocus a owl:ObjectProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range :RunFocus ;
    rdfs:label "run focus"@en ;
    rdfs:comment "Links a workout to its k-means run type from the clustering of run shapes. Runs without a time-series-derived label (727 of 40,186) are left unassigned."@en .

:hasWorkout a owl:ObjectProperty ;
    owl:inverseOf :performedBy ;
    rdfs:domain :Athlete ;
    rdfs:range :RunningWorkout ;
    rdfs:label "has workout"@en .

:hasTelemetryPoint a owl:ObjectProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range :TelemetryPoint ;
    rdfs:label "has telemetry point"@en .

:pacoIntensity a owl:ObjectProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:label "PACO intensity"@en ;
    rdfs:comment "Intensity of the session expressed on PACO's three-level scale (Low, Moderate, Vigorous), bridging the dataset's workout_type values to PACO."@en .

#Datatype properties
:userId a owl:DatatypeProperty ;
    rdfs:domain :Athlete ;
    rdfs:range xsd:integer ;
    rdfs:label "user ID"@en .

:workoutId a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:integer ;
    rdfs:label "workout ID"@en .

:durationMinutes a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "duration in minutes"@en ;
    rdfs:seeAlso paco:By_duration .

:hrMean a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "mean heart rate (BPM)"@en .

:hrStd a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "heart rate standard deviation (BPM)"@en .

:hrMin a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "minimum heart rate (BPM)"@en .

:hrMax a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "maximum heart rate (BPM)"@en .

:speedMean a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "mean speed (km/h)"@en .

:speedMax a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "maximum speed (km/h)"@en .

:altitudeGain a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "total altitude gain (m)"@en .

:sequenceIndex a owl:DatatypeProperty ;
    rdfs:domain :TelemetryPoint ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "sequence index"@en ;
    rdfs:comment "Zero-based position (0 to 499) of the observation within the resampled workout array."@en .

#Dashboard KPI's
:ZoneSource a owl:Class ;
    rdfs:label "Zone Source"@en ;
    rdfs:comment "Where the heart rate zone shares of a run came from."@en .

:TimeSeriesZones a :ZoneSource ;
    rdfs:label "Time-series zones"@en ;
    rdfs:comment "Zone shares measured from the heart rate time series (time-weighted samples)."@en .

:SummaryEstimatedZones a :ZoneSource ;
    rdfs:label "Summary-estimated zones"@en ;
    rdfs:comment "Zone shares estimated from the run summary (hr_mean, hr_std, hr_min, hr_max) because no time series exists for the run."@en .

:zoneSource a owl:ObjectProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range :ZoneSource ;
    rdfs:label "zone source"@en .

:startDate a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:date ;
    rdfs:label "start date"@en ;
    rdfs:comment "Calendar day the workout started (workouts.csv start_date)."@en .

:distanceKm a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "distance (km)"@en ;
    rdfs:seeAlso paco:By_distance .

:paceMinPerKm a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "average pace (min/km)"@en ;
    rdfs:comment "60 / mean speed in km/h."@en .

:lowZoneShare a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "low zone share"@en ;
    rdfs:comment "Fraction (0-1) of the run below 80 percent of the reference maximum heart rate."@en .

:moderateZoneShare a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "moderate zone share"@en ;
    rdfs:comment "Fraction (0-1) of the run from 80 up to 90 percent of the reference maximum heart rate."@en .

:highZoneShare a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "high zone share"@en ;
    rdfs:comment "Fraction (0-1) of the run at or above 90 percent of the reference maximum heart rate."@en .

:trainingLoad a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "training load (points)"@en ;
    rdfs:comment "Edwards-style training impulse: minutes x (1 x low share + 2 x moderate share + 3 x high share)."@en .

:beatsPerKm a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "heartbeats per km"@en ;
    rdfs:comment "Mean heart rate x pace in min/km: the cardiac cost of each kilometre."@en .

:hrDriftPct a owl:DatatypeProperty ;
    rdfs:domain :RunningWorkout ;
    rdfs:range xsd:float ;
    rdfs:label "heart rate drift (%)"@en ;
    rdfs:comment "Change of the heart-rate-to-speed ratio from the first to the second half of the run (time series only)."@en .

# Example Instance Data (Mapped from One Dataset Row)

:Athlete_104 a :Athlete ;
    :userId 104 .

:Workout_58291 a :SteadyRun ;
    :workoutId 58291 ;
    :performedBy :Athlete_104 ;
    :pacoIntensity paco:Moderate ;
    :distanceKm "8.6"^^xsd:float ;
    :durationMinutes "45.5"^^xsd:float ;
    :hrMean "154.2"^^xsd:float ;
    :hrStd "8.6"^^xsd:float ;
    :hrMin "118.0"^^xsd:float ;
    :hrMax "171.0"^^xsd:float ;
    :speedMean "11.4"^^xsd:float ;
    :speedMax "13.8"^^xsd:float ;
    :altitudeGain "92.0"^^xsd:float ;
    :hasTelemetryPoint :Point_58291_0 .

:Point_58291_0 a :TelemetryPoint ;
    :sequenceIndex 0 ;
    sosa:phenomenonTime "2019-04-10T07:30:00Z"^^xsd:dateTime ;
    sosa:hasMember :Obs_58291_0_HR ,
                   :Obs_58291_0_Speed ,
                   :Obs_58291_0_Alt .

:Obs_58291_0_HR a sosa:Observation ;
    sosa:observedProperty :HeartRate ;
    sosa:hasSimpleResult "122.0"^^xsd:float ;
    qudt:unit unit:BEAT-PER-MIN .

:Obs_58291_0_Speed a sosa:Observation ;
    sosa:observedProperty :Speed ;
    sosa:hasSimpleResult "10.2"^^xsd:float ;
    qudt:unit unit:KM-PER-HR .

:Obs_58291_0_Alt a sosa:Observation ;
    sosa:observedProperty :Altitude ;
    sosa:hasSimpleResult "14.5"^^xsd:float ;
    qudt:unit unit:M .